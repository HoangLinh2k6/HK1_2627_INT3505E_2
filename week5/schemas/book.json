{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "Book",
    "properties": {
        "id": {
            "type": "integer"
        },
        "title": {
            "type": "string"
        },
        "isbn": {
            "type": "string"
        },
        "price_vnd": {
            "type": "integer"
        },
        "stock": {
            "type": "integer"
        },
        "category": {
            "type": "string"
        },
        "authors": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": ["title", "isbn", "price_vnd", "stock"]
}